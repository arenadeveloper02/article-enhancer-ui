generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EnhancementLog {
  id          String   @id @default(cuid())
  articleUrl  String
  contentType String
  email       String?
  createdAt   DateTime @default(now())
  updatedAt    DateTime @default(now())
}
