generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Persists one row per enhancement run at execution time. createdAt
// (@default(now())) is read back by /api/history to enrich upstream history
// entries with real run timestamps.
model EnhancementLog {
  id          String   @id @default(cuid())
  articleUrl  String
  contentType String
  email       String?
  createdAt   DateTime @default(now())
}
